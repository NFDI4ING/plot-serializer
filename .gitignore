# Ignore everything in the *root directory*
/*

# Ignore all pycache folders everywhere
__pycache__

/tests/deserializer_matrix/new_deserializer2d.png
/tests/deserializer_matrix/new_deserializer3d.png

# Don't ignore the following files/folders in the root directory
!/.gitlab
!/.vscode
!/tests
!/plot_serializer
!/doc

!/.gitignore
!/make.bat
!/Makefile
!/CONTRIBUTORS.md
!/CONTRIBUTING.md
!/pyproject.toml
!/requirements.txt

# Ignore autosummary from documentation
/doc/_autosummary
